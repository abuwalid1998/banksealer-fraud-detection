# Copy to .env and adjust. Every value is optional for local testing.

# development (default): seeds demo users with temporary passwords and shows them on the sign-in page
# production: no demo users, MFA required, binds 0.0.0.0, bootstrap password must come from below
VERISHIELD_ENV=development

# Server
# VERISHIELD_HOST=127.0.0.1
# VERISHIELD_PORT=8000            (PORT is also honoured, e.g. on Render/Railway/Heroku)

# Storage - SQLite in the data directory by default; set DATABASE_URL for PostgreSQL
# VERISHIELD_DATA_DIR=./data/verishield
# DATABASE_URL=postgresql://user:password@localhost:5432/verishield

# Secret used to sign tokens and encrypt the secrets vault. REQUIRED in production (keep it stable!)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# VERISHIELD_SECRET_KEY=

# Institution (first start only)
# VERISHIELD_TENANT_CODE=BOP
# VERISHIELD_TENANT_NAME=Bank of Palestine
# VERISHIELD_TENANT_CURRENCY=ILS
# VERISHIELD_TENANT_TIMEZONE=Asia/Hebron

# Bootstrap IT Admin (username 1000 / password Admin by default - forced change at first sign-in)
# VERISHIELD_BOOTSTRAP_USERNAME=1000
# VERISHIELD_BOOTSTRAP_PASSWORD=Admin

# Demo Mode synthetic data
# VERISHIELD_SEED_DEMO=true
# VERISHIELD_SEED_DEMO_USERS=true
# VERISHIELD_DEMO_CUSTOMERS=600
# VERISHIELD_DEMO_HISTORY_DAYS=45
# Live channels created and enabled in the Demo workspace (all data received is scored in real time)
# VERISHIELD_DEMO_LIVE_CHANNELS=true
# VERISHIELD_DEMO_STREAM_SPEED=60     (gateway simulator: catch up on today at 60x, then real time)
# VERISHIELD_DEMO_TCP_PORT=9009
# VERISHIELD_DEMO_HTTP_PORT=9010

# Security
# VERISHIELD_REQUIRE_MFA=false
# VERISHIELD_CORS_ORIGINS=https://other-frontend.example

# Optional SMTP for e-mail verification codes
# VERISHIELD_SMTP_HOST=smtp.example.org
# VERISHIELD_SMTP_PORT=587
# VERISHIELD_SMTP_USER=
# VERISHIELD_SMTP_PASSWORD=
# VERISHIELD_SMTP_FROM=verishield@example.org

# --- high availability (several servers, one PostgreSQL database) -----------
# VERISHIELD_CLUSTER=1
# VERISHIELD_NODE_ID=app1                 # unique per server
# VERISHIELD_TRUST_PROXY=1                # TLS terminated by the load balancer
# --- security & monitoring --------------------------------------------------
# VERISHIELD_METRICS_TOKEN=change-me      # bearer token required by /metrics
# VERISHIELD_VAULT_KEY_FILE=D:\secure\verishield\vault.keys   # vault key ring on a separately protected volume
